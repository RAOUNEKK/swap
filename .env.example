# Copy this file to .env (or .env.local) and fill in your Supabase project's
# values. Find them in Supabase Dashboard -> Project Settings -> API.
#
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon public" key — safe to expose in the
# browser because every table it can touch is protected by Row Level
# Security. NEVER put the "service_role" key here or anywhere in frontend
# code; it bypasses RLS entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
